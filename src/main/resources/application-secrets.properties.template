# ============================================================
# DuaStore — Secrets Template
# Copy this file to application-secrets.properties and fill in
# your own credentials. DO NOT commit secrets to git!
# ============================================================

# SQL Server
spring.datasource.password=your_sql_password

# Google OAuth2 — https://console.cloud.google.com/
spring.security.oauth2.client.registration.google.client-id=your-google-client-id
spring.security.oauth2.client.registration.google.client-secret=your-google-client-secret

# Gmail SMTP — use App Password (not regular password)
spring.mail.username=your-email@gmail.com
spring.mail.password=your-gmail-app-password

# Remember-me key
duastore.remember-me.key=a-random-secret-key

# Sepay (optional)
sepay.merchant-id=
sepay.secret-key=
