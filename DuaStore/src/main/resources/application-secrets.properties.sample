# === SQL Server ===
spring.datasource.password=your_db_password_here

# === Google Maps ===
google.maps.api.key=your_google_maps_api_key_here

# === Google OAuth2 ===
spring.security.oauth2.client.registration.google.client-id=your_oauth_client_id_here
spring.security.oauth2.client.registration.google.client-secret=your_oauth_client_secret_here

# === GMAIL SMTP (App Password recommended) ===
spring.mail.username=your_email@gmail.com
spring.mail.password=your_app_password_here

# === Security ===
duastore.remember-me.key=your_random_secret_key_here
