# =============================================================
# application-secrets.properties.example
# Copy this file → application-secrets.properties and fill in
# =============================================================

# === SQL Server ===
# Password for SQL Server 'sa' account (or your custom user)
spring.datasource.password=your_sqlserver_password

# === Google Maps (optional) ===
# Get an API key at https://console.cloud.google.com/ → APIs & Services → Credentials
google.maps.api.key=your_google_maps_api_key

# === Google OAuth2 (optional) ===
# Create OAuth credentials at https://console.cloud.google.com/ → APIs & Services → Credentials
# Add "http://localhost:8080/login/oauth2/code/google" as redirect URI
spring.security.oauth2.client.registration.google.client-id=your_client_id
spring.security.oauth2.client.registration.google.client-secret=your_client_secret
spring.security.oauth2.client.registration.google.scope=email,profile

# === GMAIL SMTP (optional, for order confirmations) ===
# Use an app password: https://myaccount.google.com/apppasswords
spring.mail.username=your_email@gmail.com
spring.mail.password=your_app_password

# === Security ===
duastore.remember-me.key=change-this-to-a-long-random-string
